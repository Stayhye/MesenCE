# ==========================================
# PlayStation 2 Libretro Makefile for Mesen2
# ==========================================

TARGET_NAME = mesen2
STATICLIB := $(TARGET_NAME)_libretro_ps2.a

CC  = mips64r5900el-ps2-elf-gcc
CXX = mips64r5900el-ps2-elf-g++
AR  = mips64r5900el-ps2-elf-ar

# Ultimate PS2 Compatibility, Optimization, and Safety Flags
PS2_FLAGS := -O3 -march=r5900 -mtune=r5900 -G0 -ffast-math -fomit-frame-pointer \
             -DPS2 -DABGR1555 -DVIDEO_ABGR1555 -DIOAPI_NO_64 \
             -Doff64_t=off_t -Dstat64=stat -Dfstat64=fstat \
             -fno-expensive-optimizations -D LIBRETRO \
             -fpermissive -w

CFLAGS   = $(PS2_FLAGS)
CXXFLAGS = --std=c++17 $(PS2_FLAGS) -I./ -I./Core -I./Utilities

# Source Files
LIBRETROSRC := Libretro/libretro.cpp Libretro/VfsFile.cpp
LIBRETROOBJ := $(LIBRETROSRC:.cpp=.o)

CORESRC := $(shell find Core -name '*.cpp')
COREOBJ := $(CORESRC:.cpp=.o)

UTILSRC := $(shell find Utilities -name '*.cpp' -o -name '*.c')
UTILOBJ := $(addsuffix .o,$(basename $(UTILSRC)))

SEVENZIPSRC := $(shell find SevenZip -name '*.c')
SEVENZIPOBJ := $(SEVENZIPSRC:.c=.o)

# Completely exclude Lua files on PS2 to avoid missing socket dependencies
LUAOBJ := 

ALL_OBJS := $(LIBRETROOBJ) $(SEVENZIPOBJ) $(UTILOBJ) $(COREOBJ)

all: libretro

libretro: $(ALL_OBJS)
	$(AR) rcs $(STATICLIB) $^

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(ALL_OBJS)
	rm -f $(STATICLIB)